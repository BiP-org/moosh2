{
    "name": "tmuras2/moosh",
    "description": "moosh2 — Moodle Shell, rewritten with Symfony Console",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/tmuras2/moosh",
    "keywords": ["moodle", "shell", "cli"],
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-pcre": "*",
        "ext-libxml": "*",
        "ext-zip": "*",
        "symfony/console": "^7.0",
        "phpmussel/core": "^3.7"
    },
    "autoload": {
